# ==============================================================================
# Accounting 核心系统 Docker 一键编排环境变量配置 (.env)
# ==============================================================================

# 项目命名空间
COMPOSE_PROJECT_NAME=accounting

# 端口映射配置
FRONTEND_PORT=8000
BACKEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_CONSOLE_PORT=8849
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_DASHBOARD_PORT=8088
XXL_JOB_PORT=8082
XXL_JOB_EXECUTOR_PORT=9999

# 中间件凭据与安全密钥
MYSQL_ROOT_PASSWORD=dev@1234
REDIS_PASSWORD=dev@1234
XXL_JOB_ACCESS_TOKEN=default_secret

# Nacos 配置
# v3.2.x 镜像：无论是否启用鉴权，NACOS_AUTH_TOKEN 与 NACOS_AUTH_IDENTITY_KEY/VALUE 均为必填项
# 格式要求：NACOS_AUTH_TOKEN 必须是长度 >= 32 字节原始字符串的 Base64 编码
NACOS_VERSION=v3.2.1
NACOS_NAMESPACE=dev
NACOS_USERNAME=dev
NACOS_PASSWORD=dev@kltb@2026
NACOS_AUTH_TOKEN=QWNjb3VudGluZ05hY29zU2VjcmV0S2V5MjAyNkBrbHRi
NACOS_AUTH_IDENTITY_KEY=nacos
NACOS_AUTH_IDENTITY_VALUE=nacos

# 镜像版本标签
ROCKETMQ_VERSION=5.3.1
XXL_JOB_VERSION=3.0.0
MYSQL_VERSION=8.0
REDIS_VERSION=7.2-alpine
