# ===================== 通用系统/编辑器文件 =====================

# 工作日志和工作任务提示词
docs/tasks
docs/worklog

# 操作系统自动生成的文件
.DS_Store
Thumbs.db
desktop.ini

# 编辑器/IDE 配置文件
.idea/
.vscode/
*.swp
*.swo
*.un~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace
.history/
*.iml

# maven配置
target/

# ===================== Node.js/前端项目 =====================
# 依赖目录（核心，必须忽略）
node_modules/
# npm 缓存/日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# 构建产物
dist/
build/
out/
# 环境变量文件（包含敏感信息）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# npm 包锁文件（可选：如果团队统一用 yarn/pnpm，可忽略 package-lock.json）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ===================== Python 项目（按需保留） =====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ===================== 其他通用忽略 =====================
# 日志文件
logs/
*.log
# 缓存文件
.cache/
tmp/
temp/
# 压缩包
*.zip
*.tar.gz
*.rar
# 测试报告/覆盖率
coverage/
.nyc_output/
# Docker 临时文件
.dockerignore
