<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kltb.accounting.core.infrastructure.persistence.mapper.AccountingRuleDetailMapper">

    <resultMap id="RuleDetailResultMap" type="com.kltb.accounting.core.infrastructure.persistence.entity.AccountingRuleDetailPO">
        <id property="id" column="id"/>
        <result property="ruleId" column="rule_id"/>
        <result property="rowNum" column="row_num"/>
        <result property="fundsType" column="funds_type"/>
        <result property="subjectCode" column="subject_code"/>
        <result property="accountScope" column="account_scope"/>
        <result property="debitCredit" column="debit_credit"/>
        <result property="currency" column="currency"/>
        <result property="unilateral" column="is_unilateral"/>
        <result property="extendScript" column="extend_script"/>
        <result property="summary" column="summary"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDelete" column="is_delete"/>
        <result property="tenantId" column="tenant_id"/>
    </resultMap>

    <!-- EXPLAIN verified: type=ref, key=uk_rule_id -->
    <select id="selectWithAuxiliary" resultMap="RuleDetailResultMap">
        SELECT d.id, d.rule_id, d.row_num, d.funds_type, d.subject_code, d.account_scope,
               d.debit_credit, d.currency, d.is_unilateral, d.extend_script, d.summary,
               d.create_time, d.update_time, d.is_delete, d.tenant_id
        FROM t_accounting_rule_detail d
        WHERE d.rule_id = #{ruleId}
          AND d.is_delete = 0
        ORDER BY d.row_num ASC
    </select>

    <!-- 逻辑删除规则明细（is_delete = id，避免固定值 1 造成的 uk_rule_id 唯一索引冲突） -->
    <update id="logicDeleteByRuleId">
        UPDATE t_accounting_rule_detail
        SET is_delete = id
        WHERE rule_id = #{ruleId}
          AND is_delete = 0
    </update>

</mapper>
